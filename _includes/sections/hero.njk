    <!-- Hero -->
    <section class="ws-hero" id="hero">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-9 col-xl-8 text-center">
            <!-- Top badge -->
            <div class="ws-badge-pill">
              For online stores, startups &amp; growing businesses across the Gulf
            </div>

            <!-- Headline (single h1 for SEO) -->
            <h1 class="ws-hero-h1 ws-hero-h1--split">
              <span class="ws-hero-h1__line">
                Your complete tech team, without hiring one
              </span>
              <span
                class="ws-hero-h1__line ws-hero-h1--blue"
               
               
              >
                from idea to launch, and beyond.
              </span>
            </h1>

            <!-- Description -->
            <p class="ws-hero-desc">
              Have an idea, an online store, or a business that needs reliable tech support?
              We design, build, and maintain your website, app, or platform, so you can focus
              on growth instead of bugs and juggling freelancers.
            </p>

            <!-- Buttons -->
            <div class="ws-hero-btns">
              <a
                href="https://wa.me/{{ site.whatsapp }}?text={{ 'Hello Wusul, I\'d like a free quick review of my project.' | urlencode }}"
                class="btn ws-btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >Free Quick Review</a>
              <a href="#services" class="btn ws-btn-outline">Our Services</a>
            </div>
          </div>
        </div>

        <!-- Trusted by — directly under CTAs (Stripe-style) -->
        <div class="ws-trusted ws-trusted--hero text-center">
          <p class="ws-trusted-title">Trusted by ambitious brands</p>
          <div class="ws-trusted-placeholder">
            <span><img src="assets/images/logos/logo-omran.webp" alt="Omran" /></span>
            <span><img src="assets/images/logos/logo-basma.webp" alt="Basma" /></span>
            <span><img src="assets/images/logos/logo-sodo.webp" alt="SODO" /></span>
            <span><img src="assets/images/logos/logo-melora.webp" alt="Melora" /></span>
            <span><img src="assets/images/logos/logo-bita.webp" alt="BITA" /></span>
          </div>
        </div>

        <p class="ws-stats-band__heading" data-aos="fade-up" data-aos-delay="550">
          Our track record
        </p>
      </div>

      <!-- Stats band — full-width section at hero base -->
      <div class="ws-stats-band">
        <div class="container">
          <div class="ws-stats-band__grid">
            <div class="ws-stats-band__metric" data-aos="fade-up" data-aos-delay="100">
              <div class="ws-stats-band__num" data-count="75">+0</div>
              <p class="ws-stats-band__lbl">Satisfied Clients</p>
            </div>
            <div class="ws-stats-band__metric" data-aos="fade-up" data-aos-delay="200">
              <div class="ws-stats-band__num" data-count="86">+0</div>
              <p class="ws-stats-band__lbl">Completed Projects</p>
            </div>
            <div class="ws-stats-band__metric" data-aos="fade-up" data-aos-delay="300">
              <div class="ws-stats-band__num" data-count="97">+0</div>
              <p class="ws-stats-band__lbl">On-Time Delivery</p>
            </div>
          </div>
        </div>
      </div>
    </section>
