<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="{{ description }}" />
<title>{{ title }}</title>
{% set canonicalUrl = site.url + (page.url | replace("index.html", "")) %}
<link rel="canonical" href="{{ canonicalUrl }}" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#2563EB" />

<!-- Open Graph / social previews (WhatsApp, LinkedIn, X, Facebook) -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:title" content="{{ title }}" />
<meta property="og:description" content="{{ description }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
<meta property="og:image" content="{{ site.url }}{{ site.ogImage }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ title }}" />
<meta name="twitter:description" content="{{ description }}" />
<meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}" />

<!-- Structured data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "{{ site.url }}/#organization",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}/",
  "logo": "{{ site.url }}/assets/images/logo.png",
  "image": "{{ site.url }}{{ site.ogImage }}",
  "description": "Wusul designs, builds and supports websites, apps and platforms for online stores, startups and growing businesses across the Gulf.",
  "email": "{{ site.email }}",
  "telephone": "+{{ site.whatsapp }}",
  "areaServed": ["SA", "AE", "KW", "QA", "BH", "OM"],
  "sameAs": ["{{ site.social.linkedin }}", "{{ site.social.instagram }}"],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "sales",
    "email": "{{ site.email }}",
    "telephone": "+{{ site.whatsapp }}",
    "availableLanguage": ["Arabic", "English"]
  }
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@300;400;500&display=swap"
  rel="stylesheet"
/>
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
  integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
/>
{% if aos %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
{% endif %}
<link rel="stylesheet" href="css/variables.css" />
{# Same files and order as the @imports in css/style.css, loaded in parallel #}
{% for file in cssFiles %}
<link rel="stylesheet" href="{{ file }}" />
{% endfor %}
{% if extraStylesheets %}
{% for sheet in extraStylesheets %}
<link rel="stylesheet" href="{{ sheet }}" />
{% endfor %}
{% endif %}
<link rel="icon" type="image/png" href="assets/icons/logo.png" />
